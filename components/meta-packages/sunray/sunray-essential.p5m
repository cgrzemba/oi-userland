set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value=$(HUMAN_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

# graphical desktop
depend fmri=mate_install type=require

# DHCP service
depend fmri=service/network/dhcp/isc-dhcp type=require

# GDM and Gnome greeter, gdm-session-worker has to run in 32bit
depend fmri=system/display-manager/gdm@2.30.7 type=require
depend fmri=gnome/gnome-session@2.32.1 type=require
depend fmri=gnome/window-manager/metacity@2.34.13 type=require
depend fmri=library/desktop/gnome-desktop@2.32.1 type=require
depend fmri=gnome/gnome-settings-daemon@2.32.1 type=require
depend fmri=library/gnome/libgnomekbd@2.91.92 type=require
# only for loginGUI
depend fmri=cde/cde-runtime@0.5.11 type=require
#
# 32bit libraries
depend fmri=system/library/freetype-2/32 type=require
depend fmri=library/c++/harfbuzz/32 type=require
# depend fmri=library/brotli/32 type=require
# depend fmri=compress/bzip2/32 type=require
depend fmri=x11/library/libxfont2/32@2.0.7 type=require
# XXX ??? XXX
depend fmri=library/desktop/gdk-pixbuf/32 type=require
depend fmri=library/glib2/32 type=require
# depend fmri=library/libffi/32 type=require
# depend fmri=library/pcre2/32 type=require
depend fmri=library/expat/32 type=require
depend fmri=system/library/fontconfig/32 type=require

# install requirements rpm2cpio
depend fmri=package/rpm type=require

# utaudio 32bit libs
depend fmri=library/audio/pulseaudio/32 type=require
depend fmri=audio/mpg123/32 type=require
depend fmri=codec/flac-15 type=require
depend fmri=library/libsndfile/32 type=require
# depend fmri=library/sdl2/32@2.30.0 type=require
# depend fmri=library/libvorbis type=require
# depend fmri=library/opus type=require
# depend fmri=library/libogg type=require
# depend fmri=audio/lame type=require

# empty metapackage for SUNWkio-libs
depend fmri=compatibility/packages/SUNWxwplt type=require

# for Sun JRE
depend fmri=system/library/c++/sunpro type=require

# uttsc-bin (RDP client)
# if 32bit support removed from the component, then
# for gdm-session-worker
# x11/library/libx11/32
# x11/library/libxau/32
# x11/library/libxcb/32
# x11/library/libxext/32
# x11/library/libxinerama
# x11/library/libxcomposite
# library/nspr/32
# library/zlib/32
# library/c++/graphite2/32
# library/desktop/gtk3/32
# image/library/libpng16/32
# library/desktop/pango/32
# library/graphics/pixman/32
# library/desktop/cairo/32
# library/icu-75/32

# for other SRSS binaries and libraries
# x11/library/libx11
# x11/library/libxdmc
# x11/library/libxscrnsaver
# x11/library/libxrender
# x11/library/libxrandr
# system/library/mozilla-nss@3

# for utaudio

# utresexec
# system/library/security/libsasl 
