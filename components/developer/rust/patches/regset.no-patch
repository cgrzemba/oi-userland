This is from Oracle, pkgsrc use an other attempt to fix

diff --git a/src/rustllvm/Linker.cpp b/src/rustllvm/Linker.cpp
index 7916721..d9c3b16 100644
--- src/rustllvm/Linker.cpp
+++ src/rustllvm/Linker.cpp
@@ -1,3 +1,11 @@
+// Avoid collision in llvm header files with CS and FS as these are
+// defined in Solaris regset.h header (intel only issue + built with gcc).
+#if defined(__sun__) && !defined(__sparc__)
+#include <sys/regset.h>
+#undef CS
+#undef FS
+#endif
+
 #include "llvm/Linker/Linker.h"
 
 #include "rustllvm.h"
diff --git a/src/rustllvm/rustllvm.h b/src/rustllvm/rustllvm.h
index a9d267c..f2a0643 100644
--- src/rustllvm/rustllvm.h
+++ src/rustllvm/rustllvm.h
@@ -1,3 +1,11 @@
+// Avoid collision in llvm header files with CS and FS as these are
+// defined in Solaris regset.h header (intel only issue + built with gcc).
+#if defined(__sun__) && !defined(__sparc__)
+#include <sys/regset.h>
+#undef CS
+#undef FS
+#endif
+
 #include "llvm-c/BitReader.h"
 #include "llvm-c/Core.h"
 #include "llvm-c/ExecutionEngine.h"
